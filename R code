# ============================================================
# SCRIPT COMPLETO: ANÁLISIS Y FIGURAS DE ALTO IMPACTO
# Intervención Educativa con Zotero - Bases Celulares de la Vida
# ============================================================

# 1. INSTALACIÓN Y CARGA DE PAQUETES
if (!require("pacman")) install.packages("pacman")
pacman::p_load(tidyverse, rstatix, ggpubr, writexl, patchwork)

# 2. DIRECTORIO DE TRABAJO
setwd("/home/isra/Documentos/Art_EducSci")

# 3. CARGA DE DATOS ORIGINALES
datos <- read.csv(
  "IntervencionCSV.csv",
  header = TRUE,
  stringsAsFactors = FALSE,
  check.names = FALSE
)

# Estandarizar nombre de la columna de estudiantes
names(datos)[1] <- "Estudiante"


# ============================================================
# 4. PROCESAMIENTO Y DERIVACIÓN DE MÉTRICAS
# ============================================================

datos <- datos %>%
  mutate(
    Pre = rowMeans(select(., Pre1, Pre2, Pre3), na.rm = TRUE),
    Post = rowMeans(select(., Post1, Post2, Post3), na.rm = TRUE),
    Cambio = Post - Pre,
    Clasificacion = case_when(
      Cambio > 0 ~ "Improved",
      Cambio == 0 ~ "Unchanged",
      Cambio < 0 ~ "Worsened"
    ),
    Clasificacion = factor(Clasificacion, levels = c("Improved", "Unchanged", "Worsened")),
    Porcentaje_Mejora = case_when(
      Pre > 0 ~ ((Post - Pre) / Pre) * 100,
      Pre == 0 ~ NA_real_
    ),
    Trajectory_Type = if_else(Cambio < 0, "Worsened", "Normal/Improved")
  )

# Crear formatos largos para análisis temporales y globales
datos_largos <- datos %>%
  select(Estudiante, Pre, Post) %>%
  pivot_longer(cols = c(Pre, Post), names_to = "Moment", values_to = "Score") %>%
  mutate(Moment = factor(Moment, levels = c("Pre", "Post")))

datos_tareas <- datos %>%
  select(Estudiante, Pre1, Pre2, Pre3, Post1, Post2, Post3) %>%
  pivot_longer(cols = -Estudiante, names_to = "Task", values_to = "Score")

datos_tareas$Task <- factor(
  datos_tareas$Task,
  levels = c("Pre1", "Pre2", "Pre3", "Post1", "Post2", "Post3")
)

promedios_tarea <- datos_tareas %>%
  group_by(Task) %>%
  summarise(
    Mean = mean(Score, na.rm = TRUE),
    SD = sd(Score, na.rm = TRUE),
    .groups = "drop"
  )

clasificacion <- datos %>%
  count(Clasificacion) %>%
  mutate(Porcentaje = n / sum(n) * 100)


# ============================================================
# 5. TEMA VISUAL EDITORIAL PERSONALIZADO (MINIMALISTA Y LIMPIO)
# ============================================================

theme_pub_custom <- theme_classic(base_size = 11, base_family = "sans") +
  theme(
    axis.text = element_text(color = "black", size = 10),
    axis.title = element_text(color = "black", size = 11, face = "bold"),
    axis.line = element_line(color = "black", linewidth = 0.6),
    legend.title = element_text(color = "black", size = 10, face = "bold"),
    legend.text = element_text(color = "black", size = 9),
    panel.grid.major = element_blank(),
    panel.grid.minor = element_blank(),
    plot.tag = element_text(face = "bold", size = 13, color = "#2c3e50")
  )


# ============================================================
# FIGURA 2 COMPUESTA: DINÁMICA LONGITUDINAL (Paneles A y B)
# ============================================================
# Panel A corregido para asegurar que todas las barras de error se visualicen correctamente
p2_A <- ggplot(promedios_tarea, aes(x = Task, y = Mean, group = 1)) +
  # Polígono de desviación estándar con etiqueta explícita
  geom_ribbon(aes(ymin = pmax(0, Mean - SD), ymax = Mean + SD, fill = "±1 Standard Deviation"), alpha = 0.18) +
  scale_fill_manual(name = "Dispersion", values = c("±1 Standard Deviation" = "#2980b9")) +
  # Línea de tendencia principal
  geom_line(color = "#1b4f72", linewidth = 1) +
  # Puntos con degradado secuencial de menor a mayor avance pedagógico
  geom_point(aes(fill = Task), size = 3.8, shape = 21, color = "black", stroke = 0.6) +
  scale_fill_manual(values = c(
    "Pre1" = "#d4efdf", "Pre2" = "#a9dfbf", "Pre3" = "#7dcea0",
    "Post1" = "#5499c7", "Post2" = "#2980b9", "Post3" = "#1b4f72"
  )) +
  # Barras de error (Desviación Estándar) limitadas lógicamente a 0 para evitar cortes extraños
  geom_errorbar(aes(ymin = pmax(0, Mean - SD), ymax = Mean + SD), width = 0.1, color = "black", linewidth = 0.5) +
  labs(x = "Assessment Task", y = "Mean Score") +
  ylim(0, 10) +
  theme_pub_custom +
  theme(
    axis.text.x = element_text(angle = 20, hjust = 1),
    legend.position = "right"
  )

# Panel B: Gráfica de barras con las ganancias absolutas por tarea
p2_B <- ggplot(promedios_tarea, aes(x = Task, y = Mean, fill = Task)) +
  geom_col(width = 0.6, color = "black", linewidth = 0.4, alpha = 0.85) +
  scale_fill_manual(values = c(
    "Pre1" = "#d4efdf", "Pre2" = "#a9dfbf", "Pre3" = "#7dcea0",
    "Post1" = "#5499c7", "Post2" = "#2980b9", "Post3" = "#1b4f72"
  )) +
  labs(x = "Assessment Tasks", y = "Score Absolute Gain") +
  theme_pub_custom +
  theme(legend.position = "none", axis.text.x = element_text(angle = 20, hjust = 1))

Figura_2_Compuesta <- p2_A / p2_B + plot_annotation(tag_levels = 'A')

ggsave("Figure_2_Temporal_Dynamics.png", Figura_2_Compuesta, width = 8.5, height = 8, dpi = 600)


# ============================================================
# FIGURA 3: TRAYECTORIAS INDIVIDUALES DE DESEMPEÑO (DEFINITIVA)
# ============================================================

datos_largos <- datos %>%
  select(Estudiante, Pre, Post) %>%
  pivot_longer(cols = c(Pre, Post), names_to = "Moment", values_to = "Score") %>%
  mutate(Moment = factor(Moment, levels = c("Pre", "Post"), labels = c("Pre-intervention", "Post-intervention")))

# Obtener lista de estudiantes
estudiantes_unicos <- unique(datos_largos$Estudiante)
n_estudiantes <- length(estudiantes_unicos)

# Catálogos base amplios para asegurar identidades visuales únicas
colores_base <- viridis::magma(8, begin = 0.15, end = 0.85) # 8 colores vivos magma
formas_base  <- c(15, 16, 17, 18, 25, 8, 3, 4)             # 8 formas geométricas
lineas_base  <- c("solid", "dashed", "dotted", "dotdash")    # 4 tipos de línea

# Malla con todas las combinaciones posibles (8 x 8 x 4 = 256 únicas)
malla_esteticas <- expand.grid(
  ColorID = colores_base,
  ShapeID = formas_base,
  LineID = lineas_base,
  stringsAsFactors = FALSE
)

# Asignar aleatoriamente una combinación distinta para cada estudiante
set.seed(42)
malla_asignada <- malla_esteticas[sample(nrow(malla_esteticas), n_estudiantes), ]

atributos_estudiantes <- data.frame(
  Estudiante = estudiantes_unicos,
  ColorID = malla_asignada$ColorID,
  ShapeID = malla_asignada$ShapeID,
  LineID = malla_asignada$LineID,
  stringsAsFactors = FALSE
)

# Aplicar el desplazamiento horizontal (jitter) fijo de -0.55 a 0.55
set.seed(123)
offsets_horizontales <- data.frame(
  Estudiante = estudiantes_unicos,
  X_Offset = runif(n_estudiantes, -0.20, 0.20)
)

datos_trayectorias_mod <- datos_largos %>%
  left_join(atributos_estudiantes, by = "Estudiante") %>%
  left_join(offsets_horizontales, by = "Estudiante") %>%
  mutate(
    Moment_Num = if_else(Moment == "Pre-intervention", 1, 2),
    Moment_Jittered = Moment_Num + X_Offset
  )

# Generar la Figura 3 optimizada
Figura_3 <- ggplot(
  datos_trayectorias_mod,
  aes(
    x = Moment_Jittered,
    y = Score,
    group = Estudiante,
    color = ColorID,
    shape = factor(ShapeID),
    linetype = LineID
  )
) +
  # Líneas de referencia horizontales claras para ubicar los puntos en el espacio
  geom_hline(yintercept = 0:6, color = "#ecf0f1", linewidth = 0.5) +
  # Líneas de pendiente con desplazamiento horizontal coordinado
  geom_line(
    linewidth = 0.75, 
    alpha = 0.85
  ) +
  # Puntos individuales con paleta magma y formas variadas
  geom_point(
    size = 3.2, 
    alpha = 0.95
  ) +
  scale_color_identity() +
  scale_shape_manual(values = unique(datos_trayectorias_mod$ShapeID)) +
  scale_linetype_manual(values = unique(datos_trayectorias_mod$LineID)) +
  scale_x_continuous(
    breaks = c(1, 2), 
    labels = c("Pre-intervention", "Post-intervention"),
    limits = c(0.5, 2.5) # Margen amplio para dar espacio al offset de 0.15
  ) +
  scale_y_continuous(breaks = 0:6, limits = c(0, 6)) + # Eje Y de 1 en 1 exacto
  labs(
    x = "Assessment Phase",
    y = "Average Score"
  ) +
  theme_pub_custom +
  theme(
    legend.position = "none",
    panel.grid.major.y = element_line(color = "#e2e8f0", linewidth = 0.4),
    axis.ticks.x = element_blank()
  )

# Exportar con ancho extendido (width = 9.0)
ggsave(
  "Figure_3_Individual_Trajectories.png", 
  Figura_3, 
  width = 9.0, 
  height = 5.0, 
  dpi = 600
)

