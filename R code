library(ggplot2)
library(dplyr)
library(tidyr)
library(patchwork)

# 1. Extraer los colores exactos de la Figura 4
colores_magma_vivos <- viridis::magma(10, begin = 0.1, end = 0.95)
color_decline  <- colores_magma_vivos[2] # Morado oscuro profundo (para descensos)
color_positive <- colores_magma_vivos[9] # Amarillo/naranja brillante (para ganancias)

# 2. Preparar datos de cambio neto por estudiante
datos_fig5 <- datos %>%
  select(Estudiante, Pre, Post, Cambio) %>%
  mutate(
    Estudiante = reorder(Estudiante, Cambio),
    Direccion = if_else(Cambio >= 0, "Positive Gain", "Decline")
  )

# 3. Gráfico principal tipo Lollipop / Vectorial con marcas de 1 en 1
p_main <- ggplot(datos_fig5, aes(x = Estudiante, y = Cambio)) +
  # Línea guía central en cero
  geom_hline(yintercept = 0, color = "#cbd5e1", linewidth = 0.8, linetype = "dashed") +
  # Segmentos vectoriales estilizados
  geom_segment(aes(x = Estudiante, xend = Estudiante, y = 0, yend = Cambio, color = Direccion), linewidth = 1.2, alpha = 0.75) +
  # Puntos con relleno y borde sólido elegante
  geom_point(aes(fill = Direccion), shape = 21, size = 3.5, color = "#2c3e50", stroke = 0.8, alpha = 0.9) +
  # Mapear los colores exactos de la Figura 4
  scale_fill_manual(values = c("Positive Gain" = color_positive, "Decline" = color_decline)) +
  scale_color_manual(values = c("Positive Gain" = color_positive, "Decline" = color_decline)) +
  # Eje Y con marcas estrictamente de 1 en 1 de -2 a 6.5
  scale_y_continuous(limits = c(-1, 6.5), breaks = seq(-1, 6.5, by = 1)) +
  labs(
    x = "Individual Students (Sorted by Net Progress)",
    y = "Net Score Delta (Post - Pre Intervention)"
  ) +
  theme_classic(base_size = 12) +
  theme(
    axis.text.x = element_blank(), 
    axis.ticks.x = element_blank(),
    legend.position = "none",
    panel.grid.major.y = element_line(color = "#f1f5f9", linewidth = 0.5),
    axis.title = element_text(face = "bold", color = "#0f172a"),
    axis.line = element_line(color = "#cbd5e1", linewidth = 0.6)
  )

# 4. Panel lateral derecho: Distribución de la densidad del cambio neto
p_side <- ggplot(datos_fig5, aes(y = Cambio, fill = Direccion)) +
  geom_density(alpha = 0.6, color = "#2c3e50", linewidth = 0.6) +
  geom_hline(yintercept = 0, color = "#cbd5e1", linewidth = 0.8, linetype = "dashed") +
  scale_fill_manual(values = c("Positive Gain" = color_positive, "Decline" = color_decline)) +
  scale_y_continuous(limits = c(-1, 6.5), breaks = seq(-1, 6.5, by = 1)) +
  labs(x = NULL, y = NULL) +
  theme_classic(base_size = 12) +
  theme(
    axis.text = element_blank(),
    axis.ticks = element_blank(),
    axis.line = element_blank(),
    legend.position = "none",
    panel.grid = element_blank()
  )

# 5. Combinar de forma armónica (80% principal, 20% densidad lateral)
Figura_5_Definitiva <- p_main + p_side + plot_layout(widths = c(4, 1))

# Exportar en ultra alta resolución (600 DPI)
ggsave(
  "Figure_5_Net_Gain_Vector.png", 
  Figura_5_Definitiva, 
  width = 9.5, 
  height = 5.0, 
  dpi = 600
)

