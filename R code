library(tidyverse)
library(rstatix)
library(ggpubr)

# 1. Definir directorio de trabajo
setwd("/home/isra/Documentos/Art_EducSci")

# 2. CARGAR LOS 6 ARCHIVOS DE PUNTUACIONES INDIVIDUALES POR CRITERIO
pre1 <- read.csv("Intervencion - Puntuaciones Individuales por criterio.csv", check.names = FALSE, stringsAsFactors = FALSE)
pre2 <- read.csv("Intervencion - Puntuaciones Individuales por criterio2.csv", check.names = FALSE, stringsAsFactors = FALSE)
pre3 <- read.csv("Intervencion - Puntuaciones Individuales por criterio3.csv", check.names = FALSE, stringsAsFactors = FALSE)
post1 <- read.csv("Intervencion - Puntuaciones Individuales por criterio4.csv", check.names = FALSE, stringsAsFactors = FALSE)
post2 <- read.csv("Intervencion - Puntuaciones Individuales por criterio5.csv", check.names = FALSE, stringsAsFactors = FALSE)
post3 <- read.csv("Intervencion - Puntuaciones Individuales por criterio6.csv", check.names = FALSE, stringsAsFactors = FALSE)

# 3. Función de limpieza de nombres de estudiantes
limpiar_nombre <- function(x){
  x <- trimws(x)
  x <- iconv(x, from = "UTF-8", to = "ASCII//TRANSLIT")
  x <- tolower(x)
  x <- gsub("gardunno", "garduno", x)
  x <- gsub("\\s+", " ", x)
  return(x)
}

pre1$ID <- limpiar_nombre(pre1$Estudiante)
pre2$ID <- limpiar_nombre(pre2$Estudiante)
pre3$ID <- limpiar_nombre(pre3$Estudiante)
post1$ID <- limpiar_nombre(post1$Estudiante)
post2$ID <- limpiar_nombre(post2$Estudiante)
post3$ID <- limpiar_nombre(post3$Estudiante)

# 4. Renombrar columnas estandarizadas de cada archivo
pre1 <- pre1 %>% rename(Pre1_Citas = Pre1_Citas, Pre1_Referencias = Pre1_Referencias, Pre1_Tipo = Pre1_Tipo, Pre1_Correspondencia = Pre1_Correspondencia, Pre1_Formato = Pre1_Formato)
pre2 <- pre2 %>% rename(Pre2_Citas = Pre2_Citas, Pre2_Referencias = Pre2_Referencias, Pre2_Tipo = Pre2_Tipo, Pre2_Correspondencia = Pre2_Correspondencia, Pre2_Formato = Pre2_Formato)
pre3 <- pre3 %>% rename(Pre3_Citas = Pre3_Citas, Pre3_Referencias = Pre3_Referencias, Pre3_Tipo = Pre3_Tipo, Pre3_Correspondencia = Pre3_Correspondencia, Pre3_Formato = Pre3_Formato)
post1 <- post1 %>% rename(Post1_Citas = Pre4_Citas, Post1_Referencias = Pre4_Referencias, Post1_Tipo = Pre4_Tipo, Post1_Correspondencia = Pre4_Correspondencia, Post1_Formato = Pre4_Formato)
post2 <- post2 %>% rename(Post2_Citas = Pre5_Citas, Post2_Referencias = Pre5_Referencias, Post2_Tipo = Pre5_Tipo, Post2_Correspondencia = Pre5_Correspondencia, Post2_Formato = Pre5_Formato)
post3 <- post3 %>% rename(Post3_Citas = Pre6_Citas, Post3_Referencias = Pre6_Referencias, Post3_Tipo = Pre6_Tipo, Post3_Correspondencia = Pre6_Correspondencia, Post3_Formato = Pre6_Formato)

# Seleccionar ID y columnas de criterios
pre1 <- pre1 %>% select(ID, Pre1_Citas:Pre1_Formato)
pre2 <- pre2 %>% select(ID, Pre2_Citas:Pre2_Formato)
pre3 <- pre3 %>% select(ID, Pre3_Citas:Pre3_Formato)
post1 <- post1 %>% select(ID, Post1_Citas:Post1_Formato)
post2 <- post2 %>% select(ID, Post2_Citas:Post2_Formato)
post3 <- post3 %>% select(ID, Post3_Citas:Post3_Formato)

# 5. Unir los 6 archivos en una sola base de datos por ID
datos_criterios <- pre1 %>%
  full_join(pre2, by = "ID") %>%
  full_join(pre3, by = "ID") %>%
  full_join(post1, by = "ID") %>%
  full_join(post2, by = "ID") %>%
  full_join(post3, by = "ID")

# 6. Correcciones específicas de casos particulares
datos_criterios <- datos_criterios %>%
  mutate(
    Pre2_Citas = ifelse(ID == limpiar_nombre("Muñoz Hernández Shaday"), 0, Pre2_Citas),
    Pre2_Referencias = ifelse(ID == limpiar_nombre("Muñoz Hernández Shaday"), 0, Pre2_Referencias),
    Pre2_Tipo = ifelse(ID == limpiar_nombre("Muñoz Hernández Shaday"), 0, Pre2_Tipo),
    Pre2_Correspondencia = ifelse(ID == limpiar_nombre("Muñoz Hernández Shaday"), 0, Pre2_Correspondencia),
    Pre2_Formato = ifelse(ID == limpiar_nombre("Muñoz Hernández Shaday"), 0, Pre2_Formato),
    Pre2_Formato = ifelse(ID == limpiar_nombre("Bautista Alejandro Uriel"), 0, Pre2_Formato)
  )

# 7. Transformar a formato largo para el análisis de niveles por tarea
datos_niveles <- datos_criterios %>%
  select(ID, Pre1_Citas:Pre3_Formato, Post1_Citas:Post3_Formato) %>%
  pivot_longer(
    cols = -ID,
    names_to = c("Momento", "Tarea", "Criterio"),
    names_pattern = "(Pre|Post)([0-9]+)_(.*)",
    values_to = "Nivel"
  )

# Calcular porcentajes por tarea y criterio
niveles_resumen_tarea <- datos_niveles %>%
  mutate(Nivel = factor(Nivel, levels = c(0, 1, 2))) %>%
  count(Criterio, Momento, Tarea, Nivel, .drop = FALSE) %>%
  group_by(Criterio, Momento, Tarea) %>%
  mutate(Porcentaje = n / sum(n) * 100) %>%
  ungroup()

# 8. Preparar datos y traducir para la Figura 6 final
grafico_niveles_articulo <- niveles_resumen_tarea %>%
  mutate(
    Evaluacion = case_when(
      Momento == "Pre" & Tarea == "1" ~ "Pre 1",
      Momento == "Pre" & Tarea == "2" ~ "Pre 2",
